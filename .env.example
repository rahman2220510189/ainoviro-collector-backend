# ---- Server ----
NODE_ENV=development
# 127.0.0.1 = only this computer can reach the API (safe for local dev).
# Use 0.0.0.0 when deploying (e.g. Render).
HOST=127.0.0.1
# Default 5000. Change if the port is busy.
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- CORS ----
# The only origin allowed to call the API (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000

# ---- Database (Neon) ----
# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct connection (no "-pooler"). Used by Prisma CLI for migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Hugging Face read token for the Foursquare OS Places download (gated dataset).
# Create it at https://huggingface.co/settings/tokens (type: Read). Never share it.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
