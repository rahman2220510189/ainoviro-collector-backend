# ---- Server ----
NODE_ENV=development
# 127.0.0.1 = only this computer can reach the API (safe for local dev).
# Use 0.0.0.0 when deploying (e.g. Render).
HOST=127.0.0.1
# Default 5000. Change if the port is busy.
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- CORS ----
# The only origin allowed to call the API (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000

# ---- Database (Neon) ----
# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct connection (no "-pooler"). Used by Prisma CLI for migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
# Secret used to sign login tokens. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# How long a login lasts (hours). 12 covers one office day.
SESSION_TTL_HOURS=12

# ---- Admin user (used only by: npm run seed:admin) ----
ADMIN_EMAIL=admin@example.com
# At least 12 characters.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# true when running behind a reverse proxy (e.g. Render), so the real client IP is used.
TRUST_PROXY=false

# ---- Google Places API (New) ----
# Only needed for real searches. Never commit or share it.
GOOGLE_PLACES_API_KEY=
# Real Google by default. For local development against the mock server:
#   GOOGLE_PLACES_BASE_URL=http://127.0.0.1:5055
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com

# ---- Worker ----
# Real Google requests are blocked unless this is exactly "true" (set only after approval).
GOOGLE_LIVE_REQUESTS=false
# Tasks processed in parallel by one worker process.
WORKER_CONCURRENCY=4
# Seconds to wait before checking again when there is no work.
WORKER_POLL_SECONDS=5