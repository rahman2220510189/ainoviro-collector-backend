{
  "name": "ainoviro-collector-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ainoviro Lead Collector - backend API and workers",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-db-guarantees.ts",
    "seed:admin": "tsx src/cli/seed-admin.ts",
    "seed:categories": "tsx src/cli/seed-categories.ts",
    "import:geonames": "tsx src/cli/import-geonames.ts",
    "seed:free-domains": "tsx src/cli/seed-free-domains.ts",
    "import:suppression": "tsx src/cli/import-suppression.ts",
    "seed:keywords": "tsx src/cli/seed-keywords.ts",
    "plan:search": "tsx src/cli/plan-search.ts",
    "quota:status": "tsx src/cli/quota-status.ts",
    "quota:verify": "tsx scripts/verify-quota.ts",
    "mock:google": "tsx src/cli/mock-google.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "job": "tsx src/cli/job.ts",
    "dev:clear-mock": "tsx scripts/clear-mock-data.ts",
    "quota:set": "tsx src/cli/quota-set.ts",
    "dev:show-places": "tsx scripts/show-places.ts",
