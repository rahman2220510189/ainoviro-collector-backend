{
  "name": "ainoviro-collector-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ainoviro Lead Collector - backend API and workers",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-db-guarantees.ts",
    "seed:admin": "tsx src/cli/seed-admin.ts",
    "seed:categories": "tsx src/cli/seed-categories.ts",
    "import:geonames": "tsx src/cli/import-geonames.ts",
        "seed:free-domains": "tsx src/cli/seed-free-domains.ts",
    "import:suppression": "tsx src/cli/import-suppression.ts",
        "seed:keywords": "tsx src/cli/seed-keywords.ts",
            "plan:search": "tsx src/cli/plan-search.ts",
                "quota:status": "tsx src/cli/quota-status.ts",
    "quota:verify": "tsx scripts/verify-quota.ts",
        "mock:google": "tsx src/cli/mock-google.ts",
            "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "job": "tsx src/cli/job.ts",
        "dev:clear-mock": "tsx scripts/clear-mock-data.ts",
            "quota:set": "tsx src/cli/quota-set.ts",
    "dev:show-places": "tsx scripts/show-places.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
