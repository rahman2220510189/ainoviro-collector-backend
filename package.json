        "overture:categories": "tsx src/cli/overture-categories.ts",
            "overture:map": "tsx src/cli/overture-map.ts",
    "categorymap:verify": "tsx scripts/verify-category-map.ts",
    "merge:overture": "tsx src/cli/merge-overture.ts",
"merge:verify": "tsx scripts/verify-merge-overture.ts",
"freesources:verify": "tsx scripts/verify-free-sources.ts",
"refresh:verify": "tsx scripts/verify-dataset-refresh.ts",
"pipeline:lock": "tsx src/cli/pipeline-lock.ts",
"import:foursquare": "tsx src/cli/import-foursquare.ts",
"foursquare:categories": "tsx src/cli/foursquare-categories.ts",
"foursquare:verify": "tsx scripts/verify-foursquare.ts",
"db:size": "tsx src/cli/db-size.ts",
"places:prune": "tsx src/cli/prune-places.ts",
"db:compact": "tsx src/cli/db-compact.ts",
"countries:verify": "tsx scripts/verify-countries.ts",
"shop:verify": "tsx scripts/verify-shop-check.ts",
"shop:report": "tsx src/cli/shop-report.ts",
"border:verify": "tsx scripts/verify-country-border.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "fastify": "^5.12.5",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.5"
